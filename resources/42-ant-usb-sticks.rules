# Udev rules for Dynastream ANT USB sticks (installed by openant as
# python -m openant.udev_rules; install here to
# /etc/udev/rules.d/42-ant-usb-sticks.rules and run:
#   sudo udevadm control --reload-rules && sudo udevadm trigger)

# ANTUSB2 stick
SUBSYSTEM=="usb", ATTRS{idVendor}=="0fcf", ATTRS{idProduct}=="1008", MODE="0666", GROUP="plugdev"
# ANTUSB-m stick
SUBSYSTEM=="usb", ATTRS{idVendor}=="0fcf", ATTRS{idProduct}=="1009", MODE="0666", GROUP="plugdev"
# Serial ANT stick
SUBSYSTEM=="usb", ATTRS{idVendor}=="0fcf", ATTRS{idProduct}=="1004", MODE="0666", GROUP="plugdev"
KERNEL=="ttyUSB*", ATTRS{idVendor}=="0fcf", ATTRS{idProduct}=="1004", MODE="0666", GROUP="plugdev"
